# IRB Copilot — environment configuration.
# Copy to `.env` and fill in secrets. Every variable the app reads is documented here.
# The best retrieval/prompt defaults are set by the evaluation (§11) and pinned below.

# --- LLM / embeddings (default provider: OpenAI) ---
OPENAI_API_KEY=sk-...                       # required at runtime; empty is OK for tests
# OPENAI_BASE_URL=                          # override to point at an OpenAI-compatible endpoint
# Answer model: the cheapest option that does this task well (grounded extraction
# with a citation format). The committed rag_eval.csv is a pre-judge-swap pilot —
# see the RAG artifact-status note in the README before quoting its numbers.
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                          # must match EMBEDDING_MODEL's output size
EVAL_MODELS=gpt-4o-mini,gpt-4o             # comma-separated answer models, used by eval_rag.py
# LLM-as-a-judge model. gpt-5.4-mini over gpt-4o: different family from the
# gpt-4o-mini answers (no self-preference bias), accepts temperature=0 for
# reproducibility (gpt-5-mini does NOT), no reasoning-token overhead by default,
# ~3x cheaper, and far more TPM headroom than gpt-4o's 30k — which is what stops the eval from
# stalling on rate limits. Must be priced in app/providers.py PRICING.
JUDGE_MODEL=gpt-5.4-mini

# --- Retrieval / RAG behaviour ---
# Best config on the DE-BIASED eval (§11.2, 800 questions): hit@5 0.7425. bm25
# wins the STANDARD set (0.921) but collapses on realistic paraphrased queries
# (0.585), where hybrid_rerank leads (0.743) — the rank order fully reverses.
RETRIEVAL_MODE=hybrid_rerank                # bm25 | vector | hybrid | hybrid_rerank
# off = question verbatim | glossary = deterministic acronym expansion (no LLM)
# | llm = glossary + an LLM reformulation. All three are ablated by eval_retrieval.
# `off` wins: measured on the queries where expansion actually does something
# (those containing an acronym), glossary cost -0.035 hit@5 on bm25 and -0.050 on
# vector; the LLM level hurt far more. Expansion moves the query away from the
# corpus's own vocabulary, which uses the acronyms.
REWRITE_MODE=off                            # first-turn query rewriting level
CONDENSE_HISTORY=true                       # rewrite follow-ups into standalone retrieval queries
PROMPT_VERSION=v2                           # v1 | v2; RAG eval: v2 best on gpt-4o-mini (0.80 vs 0.76)
CHUNKER=structure                           # structure | naive (naive = evaluation baseline)
TOP_K=5
RRF_K=60                                    # reciprocal rank fusion constant for hybrid
RERANK_MODEL=BAAI/bge-reranker-base         # only used when RETRIEVAL_MODE=hybrid_rerank

# --- Vector store (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=irb_chunks

# --- Monitoring (Postgres) ---
POSTGRES_DSN=postgresql+psycopg://irb:irb@localhost:5432/irb

# --- API protection (important once the API is publicly reachable) ---
API_KEY=                                    # if set, /ask /ask/stream /feedback require X-API-Key
REQUIRE_API_KEY=false                        # prod overlay sets true: refuse to start without API_KEY
DOCS_ENABLED=true                            # prod overlay sets false: hide /docs /redoc /openapi.json
RATE_LIMIT_PER_MINUTE=30                     # per-client-IP; 0 disables
TRUSTED_PROXY_HOPS=1                          # reverse proxies in front (Caddy=1); real IP read this
                                             # many hops from the RIGHT of X-Forwarded-For. 0 = no proxy
MAX_QUESTION_CHARS=2000
MAX_HISTORY_MESSAGES=10
MAX_DOC_IDS=20
MAX_ANSWER_TOKENS=1500                        # hard cap on answer output tokens (cost/abuse guard)

# --- Service wiring ---
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000              # used by the Streamlit UI to call the API
UI_PORT=8501
GRAFANA_PORT=3000

# --- Local paths ---
DATA_DIR=data
RAW_DIR=data/raw
BM25_INDEX_PATH=data/bm25_index

# --- docker-compose service credentials / ports ---
POSTGRES_USER=irb
POSTGRES_PASSWORD=irb
POSTGRES_DB=irb
POSTGRES_PORT=5432
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin                       # DEV ONLY — production requires a strong value
                                             # (compose + deploy.sh refuse to start on unset/"admin")

# --- Production deploy (see deploy/README.md) ---
BIND_HOST=0.0.0.0                           # set 127.0.0.1 on a public VM (Caddy is the only entry)
SITE_ADDRESS=:80                            # your domain for auto-HTTPS, or ":80" for HTTP on the IP
# GRAFANA_ROOT_URL=/grafana/                # served under /grafana behind Caddy
